# Add these in Vercel Project > Settings > Environment Variables.
# Never commit real secret values to GitHub.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxx
RAZORPAY_KEY_SECRET=replace_with_new_rotated_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_webhook_secret
ALLOWED_ORIGIN=https://YOUR-PROJECT.vercel.app
DAILY_CLAIM_CREDITS=5

# Public defaults already exist in code; these are optional overrides:
FIREBASE_WEB_API_KEY=AIzaSyAsGtblJRafRcfPDxSwXIlklMqBSKfo8Eo
FIREBASE_DATABASE_URL=https://asprivetchat-default-rtdb.asia-southeast1.firebasedatabase.app

# ADMIN ACCOUNT (only this Firebase email account is admin)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_strong_password
